{
  "name": "discode",
  "displayName": "discode",
  "description": "Developer Presence for VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "discode.openDashboard",
        "title": "Open Discode Dashboard"
      },
      {
        "command": "discode.setPresenceStatus",
        "title": "Discode: Set Presence Status"
      }
    ],
    "configuration": {
      "title": "Discode",
      "properties": {
        "discode.backendUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Discode backend base URL. HTTPS is required except for localhost."
        },
        "discode.heartbeatIntervalSeconds": {
          "type": "integer",
          "default": 30,
          "minimum": 5,
          "maximum": 300,
          "description": "Interval in seconds between presence heartbeat pulses sent to the Discode backend."
        },
        "discode.idleTimeoutMinutes": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "Number of minutes of inactivity before automatically setting presence to Idle."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "repository":{
    "type": "git",
    "url": "https://github.com/Anveshious/discode.git"
  },
  "license": "MIT"
}
